# Base de datos (local con `npx prisma dev`, o Neon/Supabase en producción)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/tech_deals_es"

# Umbral de caída de precio para considerarlo "error de precio" (0.6 = 60%)
PRICE_ERROR_DROP_THRESHOLD=0.6

# Protege /api/ingest de invocaciones públicas. Genera un valor aleatorio.
CRON_SECRET=""

# Firma la cookie de sesión de los usuarios registrados. Genera un valor
# aleatorio largo (p. ej. `openssl rand -hex 32`) y no lo cambies una vez en
# producción o cerrará la sesión a todo el mundo.
SESSION_SECRET=""

# --- Login con Google (opcional) ---
# Credenciales OAuth de https://console.cloud.google.com/apis/credentials
# (tipo "Aplicación web"). Redirect URI a autorizar allí:
# http://localhost:3000/api/auth/google/callback (local) y
# https://<tu-dominio>/api/auth/google/callback (producción).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Alertas por Telegram (opcional) ---
# Token del bot, lo da @BotFather en Telegram al crear el bot con /newbot.
TELEGRAM_BOT_TOKEN=""
# Protege /api/telegram/webhook: mismo valor que se pasa como secret_token
# al registrar el webhook con la API de Telegram (setWebhook). Aleatorio.
TELEGRAM_WEBHOOK_SECRET=""

# --- Amazon Product Advertising API (opcional, requiere Amazon Asociados) ---
AMAZON_PAAPI_ACCESS_KEY=""
AMAZON_PAAPI_SECRET_KEY=""
AMAZON_PAAPI_PARTNER_TAG=""
