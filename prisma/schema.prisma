generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AffiliateNetwork {
  AMAZON_PAAPI
  AWIN
  TRADEDOUBLER
  MANUAL_CSV
  MOCK
}

enum AlertStatus {
  ACTIVE
  EXPIRED
  REVIEWED
}

model Store {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  logoUrl          String?
  affiliateNetwork AffiliateNetwork @default(MOCK)
  active           Boolean          @default(true)
  listings         Listing[]
  createdAt        DateTime         @default(now())
}

model Category {
  id         String             @id @default(cuid())
  name       String
  slug       String             @unique
  parentId   String?
  parent     Category?          @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[]         @relation("CategoryTree")
  products   Product[]
  favoritedBy FavoriteCategory[]
}

model Product {
  id          String            @id @default(cuid())
  title       String
  brand       String?
  model       String?
  ean         String?           @unique
  imageUrl    String?
  categoryId  String
  category    Category          @relation(fields: [categoryId], references: [id])
  listings    Listing[]
  favoritedBy FavoriteProduct[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([title])
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  passwordHash       String?
  googleId           String?            @unique
  telegramChatId     String?            @unique
  telegramLinkCode   String?            @unique
  createdAt          DateTime           @default(now())
  favoriteProducts   FavoriteProduct[]
  favoriteCategories FavoriteCategory[]
}

model FavoriteProduct {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model FavoriteCategory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, categoryId])
}

model Listing {
  id           String         @id @default(cuid())
  productId    String
  product      Product        @relation(fields: [productId], references: [id])
  storeId      String
  store        Store          @relation(fields: [storeId], references: [id])
  url          String
  currentPrice Float
  listPrice    Float?
  currency     String         @default("EUR")
  stock        Boolean        @default(true)
  lastSeenAt   DateTime       @default(now())
  priceHistory PriceHistory[]
  alerts       PriceAlert[]
  createdAt    DateTime       @default(now())

  @@unique([productId, storeId])
  @@index([storeId])
}

model PriceHistory {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id])
  price      Float
  capturedAt DateTime @default(now())

  @@index([listingId, capturedAt])
}

model PriceAlert {
  id             String      @id @default(cuid())
  listingId      String
  listing        Listing     @relation(fields: [listingId], references: [id])
  dropPercent    Float
  referencePrice Float
  newPrice       Float
  detectedAt     DateTime    @default(now())
  status         AlertStatus @default(ACTIVE)

  @@index([status])
}
